{% extends 'base.html.twig' %}

{% block title %}家計簿一覧{% endblock %}

{% block body %}
<div class="container mt-3">
    <h2>家計簿一覧</h2>
    <div class="mb-1 d-flex justify-content-end">
        <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_journal_categories') }}">
            仕訳分類
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">日付</th>
                    <th scope="col">区分</th>
                    <th scope="col">金額</th>
                    <th scope="col">品名</th>
                    <th scope="col">仕訳分類</th>
                    <th scope="col">一元記録</th>
                </tr>
            </thead>
            <tbody>
                {% for record in records %}
                <tr>
                    <td>{{ record.date ? record.date|date('Y-m-d') : '' }}</td>
                    <td>{{ record.type }}</td>
                    <td class="text-end">{{ record.amount|number_format }}</td>
                    <td>{{ record.itemName }}</td>
                    <td>{{ record.journalCategory.name }}</td>
                    <td>
                        <a class="" href="{{ path('edit_unitary_with_compact', { id: record.unitaryNote.id }) }}">{{ record.unitaryNote.title }}</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted">家計簿データが登録されていません</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
